# Mistral: Antworten, Dokumenterkennung, Sprachnotizen und der Zimmer-Check.
# Alternativ lässt sich der Schlüssel in der App unter Einstellungen hinterlegen.
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=pixtral-12b-2409
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_AUDIO_MODEL=voxtral-mini-latest

# Wissensepp als Sprachassistent (ElevenLabs Agents).
# Der Schlüssel braucht die Berechtigung "Conversational AI" und bleibt serverseitig.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VOICE_DAILY_LIMIT=20

# Dauerhafte Speicherung im Deployment.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_SECRET=
